        <mxCell id="rest-a" value="API / Adaptadores de entrada&#xa;JAX-RS (Quarkus REST)&#xa;PaymentResource • CoreTransactionResource&#xa;ReconciliationResource • PingResource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="555" y="140" width="365" height="115" as="geometry"/></mxCell>
        <mxCell id="dto-a" value="DTO REST + validación&#xa;Jackson • Hibernate Validator&#xa;Requests / Responses • Problem Details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="555" y="300" width="365" height="95" as="geometry"/></mxCell>
        <mxCell id="app-a" value="Aplicación&#xa;ReconciliationService → ReconciliationOperations&#xa;idempotencia • estado • diferencia • tolerancia&#xa;@Transactional en ReconciliationOperations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="970" y="140" width="385" height="125" as="geometry"/></mxCell>
        <mxCell id="mapping-a" value="MapStruct&#xa;ReconciliationMapper&#xa;Entity → Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="domain-a" value="Dominio&#xa;ReconciliationStatus&#xa;PENDING / MATCHED / MISMATCHED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="adapter-a" value="Persistencia / adaptador de salida&#xa;ReconciliationRepository (Panache)&#xa;ReconciliationEntity (Hibernate ORM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="385" height="105" as="geometry"/></mxCell>
        <mxCell id="db-a" value="H2 Database&#xa;dev: archivo ./data/conciliacion&#xa;test: memoria" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f4cccc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="465" width="165" height="95" as="geometry"/></mxCell>
        <mxCell id="edge-ext" value="HTTPS/HTTP&#xa;JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="external-a" target="rest-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-proto" value="describe endpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;fontSize=11;" edge="1" parent="1" source="protocol-a" target="rest-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-rest-dto" value="bind + validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="rest-a" target="dto-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-dto-app" value="invocación del servicio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="dto-a" target="app-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-app-map" value="mapeo respuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="app-a" target="mapping-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-app-domain" value="usa enum de estado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="app-a" target="domain-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-app-adapter" value="consulta / persistencia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="app-a" target="adapter-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-adapter-db" value="JDBC + ORM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="adapter-a" target="db-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tech-a" value="Tecnologías transversales: Maven Wrapper • CDI / inyección • Hibernate ORM with Panache • H2 JDBC • logging JSON (Quarkus). Configuración: app.conciliacion.tolerancia-pen (default 1.00 PEN).&#xa;La API es informativa: no ejecuta pagos ni mueve fondos." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1365" height="100" as="geometry"/></mxCell>
        <mxCell id="caveat-a" value="Nota arquitectónica: el código actual no está completamente desacoplado según hexagonal. ReconciliationOperations importa DTO/mapper REST y ReconciliationEntity/Repository JPA; el dominio contiene principalmente el enum de estado. El diagrama representa esas dependencias existentes, no una arquitectura objetivo." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1365" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="usecases" name="03 - Casos de uso">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title-u" value="Casos de uso — API de conciliación" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="35" as="geometry"/></mxCell>
        <mxCell id="system-u" value="Sistema: Servicio REST de conciliación&#xa;(Quarkus • /v1)" style="swimlane;html=1;startSize=38;rounded=1;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="900" height="740" as="geometry"/></mxCell>
        <mxCell id="actor-payment-u" value="Sistema de pagos&#xa;(informador)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="235" width="90" height="130" as="geometry"/></mxCell>
        <mxCell id="actor-core-u" value="Core bancario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="90" height="130" as="geometry"/></mxCell>
        <mxCell id="actor-query-u" value="Cliente de consulta&#xa;(operaciones)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="390" width="100" height="130" as="geometry"/></mxCell>
        <mxCell id="uc-payment-u" value="Registrar pago&#xa;y crear conciliación PENDING&#xa;POST /payments" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="160" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="uc-idempotency-u" value="Aplicar idempotencia&#xa;(devolver original si duplicado)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="825" y="160" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="uc-core-u" value="Registrar movimiento core&#xa;y resolver conciliación&#xa;POST /core-transactions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="355" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="uc-match-u" value="Calcular diferencia&#xa;y determinar MATCHED / MISMATCHED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="825" y="355" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="uc-query-u" value="Consultar conciliación&#xa;por referencia&#xa;GET /reconciliations/{ref}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="635" y="565" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="uc-ping-u" value="Verificar disponibilidad&#xa;GET /ping" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="710" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="note-u" value="Reglas / resultados alternativos&#xa;• Pago repetido: se conserva y devuelve la conciliación original.&#xa;• Core sin pago previo: respuesta 404; no crea conciliación.&#xa;• Core repetido o conciliación terminal: se devuelve el resultado original sin mutar.&#xa;• Consulta inexistente: respuesta 404. La API solo informa; no mueve fondos." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="855" width="870" height="110" as="geometry"/></mxCell>
        <mxCell id="rel-payment" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;strokeColor=#333333;" edge="1" parent="1" source="actor-payment-u" target="uc-payment-u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-payment-idem" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=none;html=1;dashed=1;endArrow=open;startArrow=none;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="uc-payment-u" target="uc-idempotency-u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-core" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;strokeColor=#333333;" edge="1" parent="1" source="actor-core-u" target="uc-core-u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-core-match" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=none;html=1;dashed=1;endArrow=open;startArrow=none;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="uc-core-u" target="uc-match-u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-query" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;strokeColor=#333333;" edge="1" parent="1" source="uc-query-u" target="actor-query-u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-ping-payment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;startArrow=none;strokeColor=#999999;" edge="1" parent="1" source="actor-payment-u" target="uc-ping-u"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
