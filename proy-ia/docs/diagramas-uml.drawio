        <mxCell id="note-s" value="Alternativas: pago duplicado → devuelve el registro existente sin modificarlo (200); core sin pago → 404 y no crea datos; conciliación terminal → devuelve resultado original; GET /v1/reconciliations/{operationReference} consulta y devuelve 200 o 404 sin mutar estado." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1360" height="95" as="geometry"/></mxCell>
