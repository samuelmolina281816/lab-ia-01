        <mxCell id="m13" value="PENDING: calcular diferencia = pago - core; comparar tolerancia" style="edgeStyle=none;html=1;dashed=1;endArrow=none;fontSize=12;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="827" y="655" as="sourcePoint"/><mxPoint x="827" y="690" as="targetPoint"/></mxGeometry></mxCell>
