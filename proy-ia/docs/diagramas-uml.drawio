        <mxCell id="title-a" value="Arquitectura lógica y comunicación — implementación actual" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="35" as="geometry"/></mxCell>
        <mxCell id="external-a" value="Sistemas consumidores&#xa;Pagos / Core bancario / Consulta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="protocol-a" value="HTTP + JSON&#xa;POST payments&#xa;POST core-transactions&#xa;GET reconciliations/{ref}" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="210" width="220" height="140" as="geometry"/></mxCell>
